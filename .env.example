# Newsletter Generator — copy to .env and fill in

APP_ENV=dev                          # dev or prod
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b             # use llama3.3:70b in prod for better quality

ANTHROPIC_API_KEY=sk-ant-...         # for Claude CLI source curation
X_BEARER_TOKEN=                      # Twitter/X API v2 Bearer Token (optional)

# Research agent
PERPLEXICA_URL=                      # e.g. http://100.118.247.106:3000 if on Minisforum
RESEARCH_ENABLED=true
RESEARCH_THRESHOLD=7                 # min relevance to trigger deep research (0-10)
RESEARCH_MAX_ARTICLES=5              # cap per research run

# Qdrant Cloud
QDRANT_URL=                          # e.g. https://xyz-123.us-east.aws.cloud.qdrant.io
QDRANT_API_KEY=                      # from Qdrant Cloud dashboard
QDRANT_COLLECTION=ai_articles

NEWSLETTER_BLOG_DIR=                 # path to whats-new-in-ai repo clone (default: ./newsletter-blog)
BLOG_GITHUB_URL=https://github.com/aag1091-alt/whats-new-in-ai
PUSH_BRANCH=main                     # branch to push to

# Tuning
TOP_N_ARTICLES=12
LOOKBACK_DAYS=1
SCHEDULE_TIME=07:00                  # daily run time (24h format)
SOURCE_REFRESH_DAYS=7                # how often Claude refreshes sources
MAX_ARTICLES_PER_SOURCE=5
MAX_ARXIV_RESULTS=15
MAX_TWEETS_PER_HANDLE=5
